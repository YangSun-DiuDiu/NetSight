; NetSight 边缘视频预览 - ZLMediaKit 最小配置
; 仅提供 HTTP-FLV 播放；RTSP 只作为客户端向摄像头拉流，不提供 RTSP 服务端
; 部署时由 deploy-video-preview.sh 替换 __ZLM_SECRET__ 与 __MEDIA_SERVER_ID__

[api]
apiDebug=0
secret=__ZLM_SECRET__
snapRoot=./www/snap/

[ffmpeg]
bin=/usr/bin/ffmpeg
cmd=ffmpeg -re -i %s -c:a aac -ar 44100 -ar 44100 -c:v copy -f flv %s

[general]
enableVhost=0
flowThreshold=1024
maxStreamWaitMS=2000
streamNoneReaderDelayMS=60000
resetWhenRePlay=1
mergeWriteMS=0
mediaServerId=__MEDIA_SERVER_ID__

[protocol]
enable_rtsp=1
; HTTP-FLV 依赖 RTMP 协议栈；RTMP 服务端端口在 [rtmp] 中设为 0，不对外暴露
enable_rtmp=1
enable_hls=0
enable_hls_fmp4=0
enable_mp4=0
enable_ts=0
enable_fmp4=0
enable_audio=1
enable_rtp=0

[hls]
segDur=2
segNum=3
segRetain=5
fileBufSize=65536
broadcastRecordTs=0
deleteDelaySec=10

[hook]
enable=1
on_play=http://127.0.0.1:8081/local/api/video/hook/on_play
on_stream_none_reader=http://127.0.0.1:8081/local/api/video/hook/none_reader
timeoutSec=5
retry=0
retry_delay=3.0

[http]
port=8000
sslport=0
dirMenu=0
allow_cross_domains=1
allow_ip_range=
charSet=utf-8
keepAliveSecond=30
maxReqSize=40960
rootPath=./www
sendBufSize=65536

[rtsp]
; 只做 RTSP 客户端拉流，不提供 RTSP 服务端
port=0
sslport=0

[rtmp]
port=0
sslport=0

[rtp_proxy]
port=0
timeoutSec=15

[rtc]
port=0
tcpPort=0
signalingPort=0
signalingSslPort=0
icePort=0
iceTcpPort=0
