[Unit]
Description=NetSight Device Collector (nams-collector)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/nams-gateway/collector/nams_collector.py
WorkingDirectory=/opt/nams-gateway
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
