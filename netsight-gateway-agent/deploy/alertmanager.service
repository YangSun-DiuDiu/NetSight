[Unit]
Description=Alertmanager for Prometheus (NetSight edge gateway)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/alertmanager/alertmanager --config.file=/opt/alertmanager/alertmanager.yml --storage.path=/opt/alertmanager/data --web.listen-address=0.0.0.0:9093 --log.level=info
WorkingDirectory=/opt/alertmanager
Restart=always
RestartSec=5
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
